! The start state of siesta.jcf on an eight times finer radial grid, where the
! exterior field solve needs more GMRES iterations.
 &SIESTA_INFO
 LADD_PERT = F, LRESISTIVE = F, LRESTART = F, LRECON = F, LASYM = F, LCOLSCALE = T,
 NITER = 1, FTOL = 1.E-20, LEVMARQ_PARAM = 1.0E-1, MUPAR = 0.0,
 NSIN = 200, NSIN_EXT = 160, MPOLIN = 5, NTORIN = 4, NFPIN = 0,
 L_VESSEL = T, EXT_EDGE_FAC = 0.25, VESSEL_FILE = 'vessel.test', MGRID_FILE = 'mgrid_test.nc',
 WOUT_FILE = '@CMAKE_CURRENT_BINARY_DIR@/wout_test.vmec.nc', RESTART_EXT = 'radial',
 L_TRACING = F,
 /
